<node id="statement:CS01"><data key="n_label">Glia in PD mount a heat-shock and unfolded-protein response (HSP70/HSP90 chaperones up)</data><data key="n_n_claims">28</data><data key="n_short">glial heat-shock / UPR response</data><data key="n_type">statement</data><data key="n_verdict">established</data></node>
<node id="statement:CS02"><data key="n_label">The stress response is shared by many cell types of a patient and across regions, not confined to one cell type</data><data key="n_n_claims">5</data><data key="n_short">shared across cell types and regions</data><data key="n_type">statement</data><data key="n_verdict">established</data></node>
<node id="statement:CS03"><data key="n_label">Neurons do not raise, or repress, chaperones in PD</data><data key="n_n_claims">3</data><data key="n_short">neuronal chaperone repression</data><data key="n_type">statement</data><data key="n_verdict">contradicted</data></node>
<node id="statement:CS04"><data key="n_label">Microglia increase in number in PD</data><data key="n_n_claims">13</data><data key="n_short">more microglia</data><data key="n_type">statement</data><data key="n_verdict">supported when pooled</data></node>
<node id="statement:CS05"><data key="n_label">Microglia switch on activation genes in PD (IL1B, GPNMB, SPP1, cathepsins)</data><data key="n_n_claims">13</data><data key="n_short">microglial activation genes</data><data key="n_type">statement</data><data key="n_verdict">partly supported</data></node>
<node id="statement:CS06"><data key="n_label">Inflammatory or activated glial states expand in PD</data><data key="n_n_claims">10</data><data key="n_short">inflammatory glial states expand</data><data key="n_type">statement</data><data key="n_verdict">largely not supported</data></node>
<node id="statement:CS07"><data key="n_label">PD astrocytes become reactive with CD44, GFAP and metallothioneins</data><data key="n_n_claims">12</data><data key="n_short">astrocyte CD44 / GFAP / metallothioneins</data><data key="n_type">statement</data><data key="n_verdict">supported</data></node>
<node id="statement:CS08"><data key="n_label">Oligodendrocytes lose myelinating identity and myelin genes</data><data key="n_n_claims">13</data><data key="n_short">oligodendrocytes lose myelin genes</data><data key="n_type">statement</data><data key="n_verdict">supported</data></node>
<node id="statement:CS09"><data key="n_label">Specific disease-associated oligodendroglial subpopulations expand in PD</data><data key="n_n_claims">11</data><data key="n_short">oligodendroglial subpopulations expand</data><data key="n_type">statement</data><data key="n_verdict">not supported as proportions</data></node>
<node id="statement:CS10"><data key="n_label">Dopaminergic neurons are lost from the substantia nigra</data><data key="n_n_claims">5</data><data key="n_short">nigral DA neuron loss</data><data key="n_type">statement</data><data key="n_verdict">supported when pooled</data></node>
<node id="statement:CS11"><data key="n_label">The loss is selective for SOX6/AGTR1-positive dopaminergic neurons</data><data key="n_n_claims">12</data><data key="n_short">AGTR1-selective DA loss</data><data key="n_type">statement</data><data key="n_verdict">AGTR1 loss yes, selectivity no</data></node>
<node id="statement:CS12"><data key="n_label">T cells infiltrate the PD brain</data><data key="n_n_claims">9</data><data key="n_short">T-cell infiltration</data><data key="n_type">statement</data><data key="n_verdict">not supported</data></node>
<node id="statement:CS13"><data key="n_label">Neurons lose synaptic, mitochondrial and metabolic gene expression</data><data key="n_n_claims">14</data><data key="n_short">neuronal synaptic / mitochondrial loss</data><data key="n_type">statement</data><data key="n_verdict">supported</data></node>
<node id="statement:CS14"><data key="n_label">Cortical neuron composition changes in Lewy-body disease</data><data key="n_n_claims">6</data><data key="n_short">cortical neuron composition</data><data key="n_type">statement</data><data key="n_verdict">excitatory loss supported</data></node>
<node id="statement:CS15"><data key="n_label">Familial PD genes point to dopaminergic neurons</data><data key="n_n_claims">4</data><data key="n_short">familial genes in DA neurons</data><data key="n_type">statement</data><data key="n_verdict">established</data></node>
<node id="statement:CS16"><data key="n_label">Common-variant PD risk acts through dopaminergic-neuron identity</data><data key="n_n_claims">6</data><data key="n_short">common variants in DA neurons</data><data key="n_type">statement</data><data key="n_verdict">not supported</data></node>
<node id="statement:CS17"><data key="n_label">Common-variant risk involves oligodendroglia and microglia</data><data key="n_n_claims">8</data><data key="n_short">common variants in glia</data><data key="n_type">statement</data><data key="n_verdict">supported</data></node>
<node id="statement:CS18"><data key="n_label">SNCA expression changes in PD</data><data key="n_n_claims">5</data><data key="n_short">SNCA expression</data><data key="n_type">statement</data><data key="n_verdict">partly supported</data></node>
<node id="background:BG-nigral-da-loss"><data key="n_evidence_type">neuropathology and stereology (human post-mortem)</data><data key="n_label">Dopaminergic neurons of the substantia nigra pars compacta are lost in Parkinson's disease, most severely in the ventrolateral tier and in calbindin-poor nigrosomes; loss of the dopaminergic phenotype precedes loss of the cells.</data><data key="n_measurement_note">Single-nucleus data are a weak instrument for counting neurons. They give each cell type's share of the nuclei captured, not cell numbers, so the share depends on how much of the nigra, white matter and neighbouring structures a dissection took: in control nigra the dopaminergic share of all nuclei ranges from 0.15% (Smajic 2022) to 35% (Volpato 2025) across datasets, and the case/control ratio from 0.14 (Kamath 2022) to 1.2 (Ma 2025). Most datasets have 5-15 donors per group. Tissue is taken at death, when the most vulnerable neurons are long gone, so cases are compared on their surviving neurons, and degenerating neuromelanin-laden neurons may not survive nuclei isolation. Sorted or enriched nuclei (Kamath 2022) cannot measure tissue composition at all. The single-cell data agree in direction (pooled across datasets, dopaminergic share of nigral neurons lower in PD), but the size of the loss is established by stereology, not by these data.</data><data key="n_n_claims">9</data><data key="n_type">background</data></node>
<node id="background:BG-braak-staging"><data key="n_evidence_type">neuropathology (human post-mortem)</data><data key="n_label">Lewy pathology in sporadic PD follows a stereotyped ascending course: it begins in the dorsal motor nucleus of the vagus and the anterior olfactory nucleus, ascends through the brainstem, then reaches the anteromedial temporal mesocortex and finally the neocortex, prefrontal and high-order association areas before primary fields.</data><data key="n_measurement_note">The atlas uses this sequence to label brain regions with the Braak stage at which Lewy pathology reaches them, and to group donors by Lewy stage. The single-cell data do not measure Lewy pathology itself; staging comes from each brain bank's neuropathology report, and is missing for several datasets.</data><data key="n_n_claims">4</data><data key="n_type">background</data></node>
<node id="background:BG-alpha-synuclein"><data key="n_evidence_type">neuropathology and human genetics</data><data key="n_label">Alpha-synuclein is the main protein component of Lewy bodies, and mutations in its gene (SNCA) cause familial, autosomal dominant PD.</data><data key="n_measurement_note">Single-nucleus RNA measures SNCA transcripts, not the aggregated protein that defines Lewy pathology, so SNCA expression changes (statement CS18) need not mirror aggregation, and neurons carrying Lewy bodies cannot be identified from RNA alone.</data><data key="n_n_claims">0</data><data key="n_type">background</data></node>
<node id="background:BG-gwas-risk"><data key="n_evidence_type">human genetics (genome-wide association)</data><data key="n_label">Common genetic variation contributes to PD risk: 90 independent genome-wide significant signals at 78 genomic regions explain 16-36% of heritable risk in people of European ancestry.</data><data key="n_measurement_note">The atlas's genetic-enrichment tests use these summary statistics, so they inherit their European-ancestry sample. Which cell types the risk acts through is a separate question: the cross-dataset re-analysis finds enrichment in oligodendrocyte identity and in genes glia and vascular cells induce in PD rather than in dopaminergic-neuron identity (statements CS16, CS17).</data><data key="n_n_claims">0</data><data key="n_type">background</data></node>
<node id="background:BG-striatal-dopamine-loss"><data key="n_evidence_type">neurochemistry (human post-mortem)</data><data key="n_label">Striatal dopamine is lost unevenly in PD: almost completely in the putamen, most in its caudal part, while most of the caudate keeps substantial dopamine; motor signs follow mainly from the putamen loss.</data><data key="n_measurement_note">The striatum contains the axon terminals of nigral dopaminergic neurons, not their cell bodies, so striatal single-nucleus data cannot show the dopamine loss itself; they show how striatal neurons and glia respond to it.</data><data key="n_n_claims">0</data><data key="n_type">background</data></node>
<node id="background:BG-complex-i"><data key="n_evidence_type">biochemistry (human post-mortem)</data><data key="n_label">Mitochondrial complex I activity is deficient in the PD brain.</data><data key="n_measurement_note">Complex I deficiency is a tissue-level enzyme activity. The single-cell data measure transcripts per cell type: neurons show falling oxidative phosphorylation genes (statement CS13), while in oligodendrocytes complex I biogenesis genes are slightly higher in PD (finding F-q-complex1-odc). Transcript levels and enzyme activity need not move together.</data><data key="n_n_claims">1</data><data key="n_type">background</data></node>
<node id="background:BG-reactive-microglia"><data key="n_evidence_type">neuropathology (immunohistochemistry, human post-mortem)</data><data key="n_label">HLA-DR-positive reactive microglia are abundant in the substantia nigra in PD, alongside Lewy bodies and free melanin.</data><data key="n_measurement_note">Immunostaining sees activated microglia where they are, around degenerating neurons in the nigra. Single-nucleus state scores average over all microglia of a sample and region, which can dilute focal activation; the re-analysis finds more microglia in PD (CS04) and individual activation genes up (CS05) but no increase of the published inflammatory transcriptional states (CS06). That says inflammatory programmes are not broadly raised across microglia, not that no microglia are activated.</data><data key="n_n_claims">1</data><data key="n_type">background</data></node>
<node id="background:BG-t-cells"><data key="n_evidence_type">neuropathology (immunohistochemistry) with mouse experiments</data><data key="n_label">CD8-positive and CD4-positive T cells are found in the brain parenchyma in PD post-mortem tissue.</data><data key="n_measurement_note">T cells are a tiny fraction of brain nuclei, so single-nucleus datasets capture few of them and compare their shares with little power. The re-analysis finds no consistent difference in T-cell shares (CS12), which leaves open whether small numbers of T cells infiltrate, as immunostaining shows.</data><data key="n_n_claims">0</data><data key="n_type">background</data></node>
